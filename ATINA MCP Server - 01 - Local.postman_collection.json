    {
      "name": "03 - Emulacion Inspect with JSON-RPC - Test MCP With Postman",
      "item": [
        {
          "name": "01 - KEYCLOAK - Obtención de Token desde Keycloak",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Save Token\", function () {",
                  "    pm.response.to.have.status(200);",
                  "",
                  "    const responseBody = pm.response.json();",
                  "",
                  "    const accessToken = responseBody.access_token;",
                  "    const refreshToken = responseBody.refresh_token;",
                  "",
                  "    pm.expect(accessToken, \"access_token no está presente\").to.be.a(\"string\");",
                  "",
                  "    // Guardar tokens OAuth",
                  "    pm.collectionVariables.set(\"access_token\", accessToken);",
                  "",
                  "    if (refreshToken) {",
                  "        pm.collectionVariables.set(\"refresh_token\", refreshToken);",
                  "    }",
                  "",
                  "    // Decodificar el payload del JWT",
                  "    const tokenParts = accessToken.split(\".\");",
                  "",
                  "    pm.expect(tokenParts.length, \"El access_token no tiene formato JWT\").to.equal(3);",
                  "",
                  "    let payloadBase64 = tokenParts[1]",
                  "        .replace(/-/g, \"+\")",
                  "        .replace(/_/g, \"/\");",
                  "",
                  "    // Agregar padding Base64 si es necesario",
                  "    while (payloadBase64.length % 4 !== 0) {",
                  "        payloadBase64 += \"=\";",
                  "    }",
                  "",
                  "    const payloadJson = decodeURIComponent(",
                  "        atob(payloadBase64)",
                  "            .split(\"\")",
                  "            .map(function (character) {",
                  "                return \"%\" + (\"00\" + character.charCodeAt(0).toString(16)).slice(-2);",
                  "            })",
                  "            .join(\"\")",
                  "    );",
                  "",
                  "    const payload = JSON.parse(payloadJson);",
                  "    const atinaToken = payload.atina_token;",
                  "",
                  "    pm.expect(",
                  "        atinaToken,",
                  "        \"El claim atina_token no está presente en el access_token\"",
                  "    ).to.be.a(\"string\");",
                  "",
                  "    // Guardar el token de Atina como variable de colección",
                  "    pm.collectionVariables.set(\"atina_token\", atinaToken);",
                  "",
                  "    console.log(\"Access token:\", accessToken);",
                  "    console.log(\"Atina token:\", atinaToken);",
                  "    console.log(\"JWT payload:\", payload);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
