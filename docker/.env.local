# ===============================================================
# JDE MCP Server -- ambiente DEV (docker compose --profile local)
# ===============================================================
#
# Este entorno solo se usa para correr sobre Docker y se accede
# Sin NGROK
#
# --- Keycloak: admin console ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=changeme_admin_password

# --- Keycloak: base de datos (Postgres) ---
KC_DB_PASSWORD=changeme_db_password

# --- OpenBao (vault de credenciales JDE) ---
OPENBAO_ROOT_TOKEN=dev-only-root-token

# --- Puertos publicados al host ---
KC_PORT=8180
BAO_PORT=8200
MCP_SERVER_PORT=8080

# --- Imagen del MCP Server: NO setear acá una imagen de un registry (ej.
# 92455890/jde-mcp-server:1.0.0) -- ese tag es el que se pushea para otra PC
# (Parte 3) y puede quedar desactualizado respecto al código fuente actual.
# "local" es justamente para probar el contenedor con el código de este
# checkout: dejar sin setear (default "jde-mcp-server:latest") y siempre
# levantar con --build (ver más abajo) para que tome el código actual.

# --- MCP Server: perfil Spring activo ---
SPRING_PROFILES_ACTIVE=local

# --- OpenBao: usado tanto por el MCP Server en el host (IntelliJ) como por el
# contenedor mcp-server de este compose. BAO_TOKEN en dev coincide con
# OPENBAO_ROOT_TOKEN; en prod usar un token acotado (ver DEPLOYMENT.md).
BAO_ADDR=http://localhost:8200
BAO_TOKEN=dev-only-root-token

# --- Gateway de Atina: TODAS las operaciones de negocio (purchase orders,
# sales order lookup/detail, item search/price) pasan por acá. Corre en OTRO
# docker compose (fuera de este), publicado en el host -- por eso se llega via
# host.docker.internal desde el contenedor mcp-server, no por nombre de servicio.
JDE_ATINA_GATEWAY_BASE_URL=http://host.docker.internal:8086

# --- Sin ngrok: Keycloak anuncia/firma con localhost:8180 (alcanzable desde el
# host -- Postman, browser). El propio Keycloak no necesita KC_HOSTNAME explícito
# acá (default de docker-compose.yml ya es http://localhost:8180), pero
# MCP_KEYCLOAK_ISSUER_URI sí hay que fijarlo -- si no, el contenedor de mcp-server
# usa el default interno http://keycloak:8080/... y el issuer no matchea lo que
# Keycloak realmente firma (401 "invalid issuer").
KC_HOSTNAME=http://localhost:8180
MCP_KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/jde-integration

# --- El contenedor de mcp-server no puede alcanzar "localhost:8180" (ahí
# "localhost" es el propio contenedor) para hacer el discovery OIDC contra el
# issuer de arriba -- este jwks-uri interno (Docker Compose) lo resuelve sin
# necesitar ngrok. Ver SecurityConfig.keycloakDecoder / KEYCLOAK_JWKS_URI en
# docker-compose.yml.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/jde-integration/protocol/openid-connect/certs

# --- Bypass de Atina (HS256) para probar sin mcp-remote/OAuth (ver DEPLOYMENT.md /
# troubleshooting: mcp-remote se cuelga ~60s pese a que el MCP Server responde rápido).
# Generado localmente solo para diagnosticar -- si el Gateway real de Atina valida la
# firma del token contra su propio secreto, esto NO va a servir para traer datos
# reales de JDE, pero SÍ sirve para probar que el protocolo MCP en sí (initialize,
# tools/list, tools/call) funciona bien sobre el túnel, sin mcp-remote de por medio.
ATINA_JWT_SECRET=123456789012345678901234567890123456789012345678901234567890
